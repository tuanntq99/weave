{
  "name": "notes",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "server"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit && npm run typecheck -w @notes/server",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:server": "npm run test -w @notes/server",
    "e2e": "node --test --test-concurrency=1 \"e2e/*.e2e.mjs\"",
    "deploy": "npm run build && wrangler deploy -c server/wrangler.jsonc"
  },
  "dependencies": {
    "@notes/sdk": "file:./packages/notes-sdk",
    "@notes/sync-protocol": "file:./packages/sync-protocol",
    "highlight.js": "11.12.0",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "fake-indexeddb": "^6.2.7",
    "playwright-core": "^1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "4.1.10"
  }
}
